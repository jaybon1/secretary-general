node_modules/

# Personal memory data — never commit
*.db
*.db-wal
*.db-shm
*.db-journal
backups/

.claude/settings.local.json
# This PC's own settings, one section per feature (src/core/this-secretary.ts; example this-secretary.local.example.json). The separate
# scripts/*.local.json files below were merged into it on 2026-11-10 (node src/cli.ts this-secretary-merge): their lines stay
# until no PC has them, so a file not yet merged is never committed.
/this-secretary.local.json
# This install's own id (src/core/secretary-id.ts): made on first use, kept across updates, never in git or a release
.secretary-id

# Embedding model download and the semantic-search server's files beside the database (state, outage, failure log, memory)
models/
*.semantic-search-server.json
*.semantic-search-server-down.json
*.semantic-search-server-failures.log
*.semantic-search-server-memory.json
# Semantic-search misses in a row (src/semantic-search/config.ts MISS_STREAK_FILE)
*.semantic-search-misses.json
# Last install check (src/setup/setup-check.ts), read by the prompt hook
*.db.setup-check.json
# This PC's dashboard settings (src/dashboard/settings.ts: addresses, port, share folders)
scripts/dashboard.local.json
# This PC's choice of providers whose usage is read and shown (src/usage/usage-settings.ts, written by the dashboard's /settings page)
scripts/usage.local.json
# This PC's answer-check settings (src/mistake-guards/mistake-guard-settings.ts: the other PC's path to the results folder, check levels)
scripts/mistake-guards.local.json
# This PC's end notice settings (src/phone-push/ntfy.ts: ntfy server, topic, token file)
scripts/phone-push.local.json

# Skills: the real skill folders are .agents/skills/<name>/ (in git). Claude Code reads .claude/skills, one link to
# .agents/skills; .agents/skills also holds links to the common skills (common-*, workspaces/_skills, from
# common-skills.json) and Ego Lite's own skill (a junction to the folder Ego Lite installs and updates). Links are made by
# `node src/cli.ts skill-links` and never go in git (git would follow a junction and track a second copy).
# .agents/skills.json is Antigravity's list of the common skills, with an absolute path (per PC), made by the same command.
/.claude/skills
/.agents/skills/common-*
/.agents/skills.json
/.agents/skills/ego-browser
