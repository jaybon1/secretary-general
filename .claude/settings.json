{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.ts\" hook session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.ts\" hook prompt",
            "timeout": 330
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/src/guards/pre-tool-hook.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Write|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/src/guards/repeat-hook.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/src/cli.ts\" hook stop",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "enabledMcpjsonServers": ["secretary"],
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "PowerShell(claude stop *)",
      "Bash(claude stop *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/worker/worker-done.ps1 *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-job/run-job.ps1 *)",
      "PowerShell(node src/cli.ts purge-log preview *)",
      "Bash(node src/cli.ts purge-log preview *)"
    ]
  }
}
